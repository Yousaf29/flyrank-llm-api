# Copy this file to .env and fill in your own values. Never commit .env.
#
# Three variables are the ONLY difference between a model on your laptop and one
# in a datacentre — which is why the provider is never hard-coded.

# --- Provider: pick ONE lane ---------------------------------------------------
# OpenRouter (hosted, free tier):
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_API_KEY=sk-or-...        (your real key)
#   LLM_MODEL=openrouter/free
#
# Ollama (local, unlimited):
#   LLM_BASE_URL=http://localhost:11434/v1/
#   LLM_API_KEY=ollama           (required but ignored)
#   LLM_MODEL=gemma3:1b
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your_key_here
LLM_MODEL=openrouter/free

# --- Behaviour toggles ---------------------------------------------------------
# LLM_STUB=1       -> skip the model, return a fixed schema-valid answer (build/debug for free)
# LLM_ENABLED=false-> kill switch: skip the model, return a safe deterministic fallback
LLM_STUB=0
LLM_ENABLED=true

# Client timeout in seconds (SDK default is 600s / 10 min — far too long for an endpoint).
LLM_TIMEOUT_SECONDS=30

# How many times to attempt the call (1 = no retry). Retries fire only on timeout / 429 / 5xx.
LLM_MAX_ATTEMPTS=3

PORT=8000
